# LLM API Configuration (DeepSeek or any OpenAI-compatible API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1 (Defaults in config.py; if needed, export in shell)

# Dual-Model Routing Configuration
FAST_MODEL=deepseek-chat          # e.g. DeepSeek-V3 for fast intent classification & AST fixes
REASONING_MODEL=deepseek-reasoner # e.g. DeepSeek-R1 for complex multi-table joins & CoT reasoning

# Database Sandbox Settings
DB_PATH=ecommerce.db
STATEMENT_TIMEOUT_SECONDS=5.0
MAX_ROW_LIMIT=100
MAX_SELF_HEAL_ROUNDS=3
